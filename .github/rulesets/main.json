{
  "name": "main review policy",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "require_code_owner_review": true,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "gate",
            "integration_id": 15368
          },
          {
            "context": "lint",
            "integration_id": 15368
          },
          {
            "context": "test (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "test (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "test-windows",
            "integration_id": 15368
          },
          {
            "context": "package",
            "integration_id": 15368
          },
          {
            "context": "binary (ubuntu-22.04)",
            "integration_id": 15368
          },
          {
            "context": "binary (macos-14)",
            "integration_id": 15368
          },
          {
            "context": "gui-app (macos-14)",
            "integration_id": 15368
          },
          {
            "context": "gui-app (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "docker",
            "integration_id": 15368
          },
          {
            "context": "shellcheck",
            "integration_id": 15368
          },
          {
            "context": "powershell",
            "integration_id": 15368
          },
          {
            "context": "installer-sh (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "installer-sh (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "installer-sh-busybox",
            "integration_id": 15368
          },
          {
            "context": "installer-ps1 (powershell)",
            "integration_id": 15368
          },
          {
            "context": "installer-ps1 (pwsh)",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    }
  ]
}
